+    uint8_t address;
+
+    void set(bool value) override { gpio_ext_set(address, pin, value); }
+    uint8_t get() { return gpio_ext_get(address, pin); }
+};
diff --git a/variants/esp32c6/arduino_nesso_n1/README.md b/variants/esp32c6/arduino_nesso_n1/README.md
