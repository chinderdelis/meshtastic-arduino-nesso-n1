diff --git a/src/nimble/NimbleBluetooth.cpp b/src/nimble/NimbleBluetooth.cpp
index e01c32c7..753b806f 100644
--- a/src/nimble/NimbleBluetooth.cpp
+++ b/src/nimble/NimbleBluetooth.cpp
@@ -753,11 +753,18 @@ class NimbleBluetoothServerCallback : public BLEServerCallbacks
 
         const uint16_t connHandle = desc->conn_handle;
 
-        // With Google Pixel 8 Android devices, this causes ESP32 device crash
-        // when phone reconnects. Disable this to make progress on the
-        // Arduino v3 migration while we investigate the Android compatibility
-        // issue.
-#if 0
+#if defined(CONFIG_IDF_TARGET_ESP32C6)
+        // Prefer 2M PHY and raise the link-layer data length (mirrors upstream master on C6/S3).
+        // The Pixel 8 reconnect crash that originally disabled the data length request dated back
+        // to the Arduino v3 migration stack; the current IDF 5.5.x NimBLE stack handles it.
+        int phyResult =
+            ble_gap_set_prefered_le_phy(connHandle, BLE_GAP_LE_PHY_2M_MASK, BLE_GAP_LE_PHY_2M_MASK, BLE_GAP_LE_PHY_CODED_ANY);
+        if (phyResult == 0) {
+            LOG_INFO("BLE conn %u preferred 2M PHY", connHandle);
+        } else {
+            LOG_WARN("Failed to prefer 2M PHY for conn %u, rc=%d", connHandle, phyResult);
+        }
+
         int dataLenResult = ble_gap_set_data_len(connHandle, kPreferredBleTxOctets, kPreferredBleTxTimeUs);
         if (dataLenResult == 0) {
             LOG_INFO("BLE conn %u requested data length %u bytes", connHandle, kPreferredBleTxOctets);
@@ -1083,4 +1090,24 @@ void NimbleBluetooth::sendLog(const uint8_t *logMessage, size_t length)
     logRadioCharacteristic->setValue(logMessage, length);
     logRadioCharacteristic->notify();
 }
+
+void NimbleBluetooth::prepareForReboot()
+{
+#ifdef ARCH_ESP32
+    // Graceful link teardown before ESP.restart(): the phone must see a real disconnect, otherwise
+    // it keeps a stale link until the supervision timeout and the post-reboot re-pairing often
+    // fails (mostly on Android).
+    isDeInit = true; // onDisconnect early-returns: no status churn, no advertising restart
+    pendingStartAdvertising = false;
+    bleDraining = true; // release any in-flight onRead wait immediately
+    if (bluetoothPhoneAPI)
+        bluetoothPhoneAPI->onReadCallbackIsWaitingForData = false;
+
+    uint16_t connHandle = nimbleBluetoothConnHandle.load();
+    if (connHandle != BLE_HS_CONN_HANDLE_NONE && bleServer) {
+        bleServer->disconnect(connHandle);
+        delay(250); // let the disconnect reach the phone before we reset
+    }
+#endif
+}
 #endif
